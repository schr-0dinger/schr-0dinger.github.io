---
import { skills, education, languages } from '../data/profile';
---

<div class="cols">
  <div>
    <p class="eyebrow">Skills</p>
    <dl class="skills">
      {skills.map((s) => (
        <div>
          <dt>{s.group}</dt>
          <dd>
            <ul role="list">
              {s.items.map((i) => (
                <li class="tag">{i}</li>
              ))}
            </ul>
          </dd>
        </div>
      ))}
    </dl>
  </div>

  <div>
    <p class="eyebrow">Education & certifications</p>
    <ul class="edu" role="list">
      {education.map((e) => (
        <li>
          <h3>{e.title}</h3>
          <p class="org">{e.org}</p>
          {e.dates && <p class="dates">{e.dates}</p>}
        </li>
      ))}
      <li>
        <h3>Languages</h3>
        <p class="org">{languages.join(', ')}</p>
      </li>
    </ul>
  </div>
</div>

<style>
  .cols {
    display: grid;
    gap: 48px;
  }
  @media (min-width: 980px) {
    .cols {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .skills {
    display: grid;
    gap: 22px;
    margin: 16px 0 0;
  }
  dt {
    font-weight: 600;
    margin-bottom: 8px;
  }
  dd {
    margin: 0;
  }
  dd ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
  }
  .edu {
    margin: 16px 0 0;
    display: grid;
    gap: 0;
  }
  .edu li {
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
  }
  .edu li:first-child {
    padding-top: 0;
  }
  h3 {
    font-size: 1.08rem;
    font-weight: 600;
  }
  .org {
    color: var(--muted);
  }
  .dates {
    font-size: 0.88rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
</style>
