---
import Icon from './Icon.astro';
import { experience } from '../data/profile';
---

<ol class="roles" role="list">
  {experience.map((r) => (
    <li class="role">
      <div class="top">
        <h3>
          {r.title}
          <span class="at">
            {r.orgUrl ? (
              <a class="link" href={r.orgUrl} target="_blank" rel="noopener">
                {r.org}
                <Icon name="arrow" size={14} />
              </a>
            ) : (
              r.org
            )}
          </span>
        </h3>
        {r.dates && <p class="dates">{r.dates}</p>}
      </div>
      {r.summary && <p class="summary">{r.summary}</p>}
      {r.points && (
        <ul class="points">
          {r.points.map((p) => (
            <li>{p}</li>
          ))}
        </ul>
      )}
    </li>
  ))}
</ol>

<style>
  .roles {
    display: grid;
    gap: 20px;
    margin: 0;
  }
  .role {
    padding: clamp(22px, 3vw, 32px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
  }
  h3 {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }
  .at {
    display: block;
    margin-top: 2px;
    font-weight: 400;
    font-size: 1rem;
    color: var(--muted);
  }
  .at a {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }
  .dates {
    font-size: 0.88rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .summary {
    margin-top: 14px;
  }
  .points {
    margin-top: 14px;
    padding-left: 1.1em;
    display: grid;
    gap: 8px;
  }
  .points li::marker {
    color: var(--accent);
  }
</style>
