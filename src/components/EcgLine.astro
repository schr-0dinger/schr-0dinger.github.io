---
// Decorative ECG trace: one sinus beat repeated, revealed left to right on load.
const beat = 'l18 0 4 -5 4 5 8 0 3 4 5 -34 5 38 3 -8 10 0 6 -8 6 8 18 0';
const beats = 13; // ~1500px wide at natural scale, clipped to the container
const d = 'M0 60 ' + Array.from({ length: beats }, () => beat).join(' ');
---

<svg class="ecg" aria-hidden="true" focusable="false">
  <path d={d} transform="translate(0 -30) scale(1.28)" />
</svg>

<style>
  .ecg {
    display: block;
    width: 100%;
    height: 64px;
    overflow: hidden;
    clip-path: inset(0 100% 0 0);
    animation: reveal 2.4s cubic-bezier(0.55, 0, 0.3, 1) 0.2s forwards;
  }
  path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.3;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  @keyframes reveal {
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ecg {
      animation: none;
      clip-path: none;
    }
  }
</style>
