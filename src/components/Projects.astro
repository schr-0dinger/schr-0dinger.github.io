---
import Icon from './Icon.astro';
import { projects, moreProjects } from '../data/profile';
---

<ul class="cards" role="list">
  {projects.map((p, i) => (
    <li class:list={['card', { featured: i === 0 }]}>
      <div class="meta">
        <span class="kind">{p.kind}</span>
        {p.status && <span class="status">{p.status}</span>}
        {p.stars && (
          <span class="stars" aria-label={`${p.stars} GitHub stars`}>
            <Icon name="star" size={13} />
            {p.stars}
          </span>
        )}
      </div>
      <h3>{p.name}</h3>
      <p class="desc">{p.description}</p>
      <ul class="tags" role="list">
        {p.tags.map((t) => (
          <li class="tag">{t}</li>
        ))}
      </ul>
      <div class="links">
        {p.links.map((l) => (
          <a class="link" href={l.href} target="_blank" rel="noopener">
            {l.label}
            <Icon name="arrow" size={14} />
          </a>
        ))}
      </div>
    </li>
  ))}
</ul>

<div class="more">
  <p class="eyebrow">Also on GitHub</p>
  <ul role="list">
    {moreProjects.map((m) => (
      <li>
        <a href={m.href} target="_blank" rel="noopener">
          <span class="m-name">{m.name}</span>
          <span class="m-desc">{m.description}</span>
          {m.stars && (
            <span class="stars" aria-label={`${m.stars} GitHub stars`}>
              <Icon name="star" size={13} />
              {m.stars}
            </span>
          )}
          <Icon name="arrow" size={16} />
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .cards {
    display: grid;
    gap: 16px;
    margin: 0;
  }
  @media (min-width: 640px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
    .featured {
      grid-column: 1 / -1;
    }
  }
  .card {
    display: flex;
    flex-direction: column;
    padding: clamp(22px, 3vw, 28px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }
  .featured {
    background:
      linear-gradient(var(--accent-soft), var(--accent-soft)),
      var(--surface);
  }
  .featured h3 {
    font-size: clamp(1.8rem, 3.4vw, 2.3rem);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .kind {
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.72rem;
  }
  .status {
    padding: 2px 8px;
    border: 1px dashed var(--line);
    border-radius: 999px;
  }
  .stars {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  h3 {
    margin-top: 12px;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.65rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  .desc {
    margin-top: 10px;
    color: var(--muted);
    max-width: 62ch;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 18px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: auto;
    padding-top: 18px;
    font-size: 0.95rem;
    font-weight: 500;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }
  .more {
    margin-top: 40px;
  }
  .more ul {
    margin-top: 12px;
    border-top: 1px solid var(--line);
  }
  .more a {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 4px 16px;
    padding: 16px 4px;
    border-bottom: 1px solid var(--line);
    transition: color 0.2s ease;
  }
  .more a:hover {
    color: var(--accent);
  }
  .m-name {
    font-weight: 600;
    grid-column: 1;
  }
  .m-desc {
    grid-column: 1;
    grid-row: 2;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .more .stars {
    grid-row: 1 / span 2;
    grid-column: 2;
  }
  .more a > :global(svg) {
    grid-row: 1 / span 2;
    grid-column: 3;
  }
</style>
