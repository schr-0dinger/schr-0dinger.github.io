---
import { person } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap row">
    <p>© {year} {person.name}</p>
    <p><a class="link" href="#top">Back to top ↑</a></p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    font-size: 0.88rem;
    color: var(--muted);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 28px;
  }
</style>
